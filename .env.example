# Server runtime configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Render disk mount paths for persistent data/uploads
DATA_DIR="/var/data"
UPLOADS_DIR="/var/data/uploads"

# Optional external service keys
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Contact inquiry email delivery (recommended for a Gmail recipient)
GMAIL_USER="gbherbarium@gmail.com"
GMAIL_APP_PASSWORD="your_16_character_google_app_password"

# Resend fallback (requires a verified sender domain for this recipient)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="GB Herbarium <inquiries@your-verified-domain.org>"
CONTACT_RECIPIENT_EMAIL="gbherbarium@gmail.com"

# Public app URL used for self-referential links or callbacks
APP_URL="MY_APP_URL"

# Frontend production API base URL for Netlify
# Example: VITE_API_URL=https://your-herbarium-api.example.com
VITE_API_URL="https://YOUR-BACKEND-DOMAIN"
